# Dependencies. No trailing slash: in a git worktree the dependency tree is a
# SYMLINK to the main checkout's install, and `node_modules/` matches only real
# directories — so the trailing-slash form left it showing up as untracked.
node_modules

# Build output. `npm run build` publishes to ../.glaze/build, outside this repo,
# and clears its staging dir afterwards — but an aborted build leaves it behind.
# `build/` (no dot) is where the CURRENT SDK stages the renderer bundle; only
# `.build/` was listed here, so a full build left ~1.4 MB of generated assets
# untracked-but-not-ignored, one `git add -A` away from being committed.
.build/
build/
dist/
# `npm run build:preview` — the browser preview's own bundle, kept in its own
# directory so it can never overwrite the renderer the packaged app loads.
build-preview/

# Test and coverage output.
# `coverage-summary.json` embeds absolute paths from the machine that ran it,
# so a committed copy leaks a home directory and conflicts on every run.
coverage/
test-results/
playwright-report/
blob-report/

# Agent scratch. The DOM snapshots in .glaze-tool-output embed absolute /Users
# paths. .glaze_memory holds the frozen originals of docs/ARCHITECTURE.md and
# docs/DECISIONS.md — superseded by those versioned copies, kept only as a
# local artifact, and no longer updated by anything.
.glaze_memory/
.glaze-tool-output/
tmp/

# Generated assets. Icons are rebuilt from package.json's `iconDescription`;
# .icon-hash is the cache key that tracks whether they are stale.
app-icon.*
.icon-hash

# Per-machine editor and agent state. These were previously ignored only by a
# global gitignore on one machine, which does not travel with a clone.
.claude/settings.local.json
.claude/.cc-writes/
.claude/worktrees/
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment files. The Anthropic API key is stored in the app's userData
# directory, never in the repo — this is a guard in case that ever changes.
.env
.env.*
!.env.example
