{
  "name": "good-looks",
  "version": "1.0.0",
  "productName": "Good Looks!",
  "description": "Record web interactions and generate runnable Playwright tests",
  "private": true,
  "type": "module",
  "main": "build/main/index.js",
  "scripts": {
    "bootstrap": "node scripts/bootstrap-worktree.mjs",
    "postinstall": "install-electron",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "lint": "eslint main renderer mcp e2e",
    "test:e2e": "npm run build && playwright test --config e2e/playwright.config.ts",
    "dev:web": "vite --mode preview",
    "build:preview": "vite build --mode preview",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "package": "node scripts/verify-package.mjs --preflight && npm run build && electron-builder --mac --dir && node scripts/verify-package.mjs --verify",
    "verify:package": "node scripts/verify-package.mjs --verify",
    "check:spec-parser": "tsx main/services/__tests__/spec-parser.check.ts",
    "check:locator-roundtrip": "tsx main/services/__tests__/locator-roundtrip.check.ts",
    "check:visual-pipeline": "esbuild main/services/__tests__/visual-pipeline.check.ts --bundle --platform=node --format=cjs --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/visual-pipeline.check.cjs && node node_modules/.cache/visual-pipeline.check.cjs",
    "check:ai-debug-scroll": "tsx main/services/__tests__/ai-debug-scroll.check.ts",
    "check:capture-overhead": "esbuild main/services/__tests__/capture-overhead.check.ts --bundle --platform=node --format=cjs --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/capture-overhead.check.cjs && node node_modules/.cache/capture-overhead.check.cjs",
    "check:retention": "esbuild main/services/__tests__/retention.check.ts --bundle --platform=node --format=cjs --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/retention.check.cjs && node node_modules/.cache/retention.check.cjs",
    "check:auto-heal-wiring": "tsx main/services/__tests__/auto-heal-wiring.check.ts",
    "check:run-filters": "tsx main/services/__tests__/run-filters.check.ts",
    "check:batch-runner": "esbuild main/services/__tests__/batch-runner.check.ts --bundle --platform=node --format=cjs --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/batch-runner.check.cjs && node node_modules/.cache/batch-runner.check.cjs",
    "check:batch-history": "esbuild main/services/__tests__/batch-history.check.ts --bundle --platform=node --format=esm --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/batch-history.check.mjs && node node_modules/.cache/batch-history.check.mjs",
    "check:routine-store": "esbuild main/services/__tests__/routine-store.check.ts --bundle --platform=node --format=esm --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/routine-store.check.mjs && node node_modules/.cache/routine-store.check.mjs",
    "check:routine-scheduler": "esbuild main/services/__tests__/routine-scheduler.check.ts --bundle --platform=node --format=esm --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --external:pngjs --outfile=node_modules/.cache/routine-scheduler.check.mjs && node node_modules/.cache/routine-scheduler.check.mjs",
    "check:test-tags": "tsx main/services/__tests__/test-tags.check.ts",
    "check:mcp-boot": "node mcp/boot.check.mjs",
    "check:mcp-select": "node mcp/select-tests.check.mjs",
    "check:metrics-db": "esbuild main/services/__tests__/metrics-db.check.ts --bundle --platform=node --format=esm --external:node:sqlite --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/metrics-db.check.mjs && node node_modules/.cache/metrics-db.check.mjs",
    "check:mcp-parity": "esbuild main/services/__tests__/mcp-parity.check.ts --bundle --platform=node --format=esm --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/mcp-parity.check.mjs && node node_modules/.cache/mcp-parity.check.mjs",
    "check:docs-blocks": "tsx main/services/__tests__/docs-blocks.check.ts",
    "check:alerts": "esbuild main/services/__tests__/alerts.check.ts --bundle --platform=node --format=cjs --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/alerts.check.cjs && node node_modules/.cache/alerts.check.cjs",
    "check:cookie-steps": "esbuild main/services/__tests__/cookie-steps.check.ts --bundle --platform=node --format=cjs --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/cookie-steps.check.cjs && node node_modules/.cache/cookie-steps.check.cjs",
    "check:batch-order": "tsx main/services/__tests__/batch-order.check.ts",
    "check:paginate": "tsx main/services/__tests__/paginate.check.ts",
    "check:step-ingest": "tsx main/services/__tests__/step-ingest.check.ts",
    "check:step-semantics": "tsx main/services/__tests__/step-semantics.check.ts",
    "check:step-progress": "tsx main/services/__tests__/step-progress.check.ts",
    "check:capture-egress": "tsx main/services/__tests__/capture-egress.check.ts",
    "check:css-assertions": "tsx main/services/__tests__/css-assertions.check.ts",
    "check:triage": "tsx main/services/__tests__/triage.check.ts",
    "check:step-insights": "tsx main/services/__tests__/step-insights.check.ts",
    "check:text-color": "tsx main/services/__tests__/text-color.check.ts",
    "check:theme-tokens": "tsx main/services/__tests__/theme-tokens.check.ts",
    "check:renderer-classes": "tsx main/services/__tests__/renderer-classes.check.ts",
    "check:status-width": "tsx main/services/__tests__/status-width.check.ts",
    "check:app-identity": "tsx main/services/__tests__/app-identity.check.ts",
    "check:sdk-retired": "tsx main/services/__tests__/sdk-retired.check.ts",
    "check:selection-neutral": "tsx main/services/__tests__/selection-neutral.check.ts",
    "check:stats-categories": "tsx main/services/__tests__/stats-categories.check.ts",
    "check:crt-untreated": "tsx main/services/__tests__/crt-untreated.check.ts",
    "check:renderer-egress": "tsx main/services/__tests__/renderer-egress.check.ts",
    "check:branch-switch": "tsx main/services/__tests__/branch-switch.check.ts",
    "check:open-external": "tsx main/services/__tests__/open-external.check.ts",
    "check:duplicate-test": "esbuild main/services/__tests__/duplicate-test.check.ts --bundle --platform=node --format=esm --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/duplicate-test.check.mjs && node node_modules/.cache/duplicate-test.check.mjs",
    "check:package-integrity": "tsx main/services/__tests__/package-integrity.check.ts",
    "check:import-sandbox": "esbuild main/services/__tests__/import-sandbox.check.ts --bundle --platform=node --format=esm --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/import-sandbox.check.mjs && node node_modules/.cache/import-sandbox.check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:checks": "npm run check:spec-parser && npm run check:locator-roundtrip && npm run check:visual-pipeline && npm run check:ai-debug-scroll && npm run check:capture-overhead && npm run check:retention && npm run check:auto-heal-wiring && npm run check:run-filters && npm run check:batch-runner && npm run check:runner-config && npm run check:batch-history && npm run check:routine-store && npm run check:routine-scheduler && npm run check:test-tags && npm run check:mcp-select && npm run check:mcp-boot && npm run check:mcp-parity && npm run check:docs-blocks && npm run check:metrics-db && npm run check:alerts && npm run check:issue-payload && npm run check:deep-link && npm run check:cookie-steps && npm run check:batch-order && npm run check:paginate && npm run check:step-ingest && npm run check:step-semantics && npm run check:step-progress && npm run check:capture-egress && npm run check:import-sandbox && npm run check:duplicate-test && npm run check:variables && npm run check:heal-journal && npm run check:flake-analysis && npm run check:scroll-layout && npm run check:narrow-layout && npm run check:script-bar && npm run check:clickable-chrome && npm run check:dialog-footer && npm run check:step-glow && npm run check:ai-debug-store && npm run check:log-capture && npm run check:run-logs && npm run check:recorder-navigation && npm run check:trainer-panel && npm run check:replay-suspend && npm run check:recorder-views && npm run check:insert-cursor && npm run check:crawl-speed && npm run check:css-assertions && npm run check:triage && npm run check:step-insights && npm run check:text-color && npm run check:theme-tokens && npm run check:renderer-classes && npm run check:status-width && npm run check:selection-neutral && npm run check:app-identity && npm run check:sdk-retired && npm run check:stats-categories && npm run check:crt-untreated && npm run check:renderer-egress && npm run check:branch-switch && npm run check:open-external && npm run check:package-integrity && npm run check:push-consumers && npm run check:derived-cache && npm run check:drift-gap && npm run check:emit-redaction",
    "test:all": "npm run test:checks && npm run test",
    "test:coverage": "vitest run --coverage",
    "check:scroll-layout": "tsx main/services/__tests__/scroll-layout.check.ts",
    "check:narrow-layout": "tsx main/services/__tests__/narrow-layout.check.ts",
    "check:script-bar": "tsx main/services/__tests__/script-bar.check.ts",
    "check:clickable-chrome": "tsx main/services/__tests__/clickable-chrome.check.ts",
    "check:dialog-footer": "tsx main/services/__tests__/dialog-footer.check.ts",
    "check:step-glow": "tsx main/services/__tests__/step-glow.check.ts",
    "check:variables": "esbuild main/services/__tests__/variables.check.ts --bundle --platform=node --format=cjs --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/variables.check.cjs && node node_modules/.cache/variables.check.cjs",
    "check:heal-journal": "esbuild main/services/__tests__/heal-journal.check.ts --bundle --platform=node --format=cjs --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/heal-journal.check.cjs && node node_modules/.cache/heal-journal.check.cjs",
    "check:flake-analysis": "esbuild main/services/__tests__/flake-analysis.check.ts --bundle --platform=node --format=cjs --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/flake-analysis.check.cjs && node node_modules/.cache/flake-analysis.check.cjs",
    "check:ai-debug-store": "esbuild main/services/__tests__/ai-debug-store.check.ts --bundle --platform=node --format=esm --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/ai-debug-store.check.mjs && node node_modules/.cache/ai-debug-store.check.mjs",
    "check:log-capture": "tsx main/services/__tests__/log-capture.check.ts",
    "check:run-logs": "esbuild main/services/__tests__/run-logs.check.ts --bundle --platform=node --format=esm --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/run-logs.check.mjs && node node_modules/.cache/run-logs.check.mjs",
    "check:recorder-navigation": "tsx main/services/__tests__/recorder-navigation.check.ts",
    "check:runner-config": "tsx main/services/__tests__/runner-config.check.ts",
    "check:repo-hygiene": "node .github/scripts/check-repo-hygiene.mjs",
    "check:shell-drift": "node .github/scripts/check-shell-drift.mjs",
    "check:crawl-speed": "esbuild main/services/__tests__/crawl-speed.check.ts --bundle --platform=node --format=esm --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/crawl-speed.check.mjs && node node_modules/.cache/crawl-speed.check.mjs",
    "check:trainer-panel": "esbuild main/services/__tests__/trainer-panel.check.ts --bundle --platform=node --format=esm --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/trainer-panel.check.mjs && node node_modules/.cache/trainer-panel.check.mjs",
    "check:replay-suspend": "tsx main/services/__tests__/replay-suspend.check.ts",
    "check:recorder-views": "tsx main/services/__tests__/recorder-views.check.ts",
    "check:insert-cursor": "tsx main/services/__tests__/insert-cursor.check.ts",
    "check:push-consumers": "tsx main/services/__tests__/push-consumers.check.ts",
    "check:derived-cache": "tsx main/services/__tests__/derived-cache.check.ts",
    "check:issue-payload": "esbuild main/services/__tests__/issue-payload.check.ts --bundle --platform=node --format=cjs --alias:@shell/backend=./main/services/__tests__/shell-backend-stub.ts --external:electron --outfile=node_modules/.cache/issue-payload.check.cjs && node node_modules/.cache/issue-payload.check.cjs",
    "check:deep-link": "tsx main/services/__tests__/deep-link.check.ts",
    "check:drift-gap": "tsx main/services/__tests__/drift-gap.check.ts",
    "check:emit-redaction": "tsx main/services/__tests__/emit-redaction.check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "1.53.0",
    "@radix-ui/colors": "^3.0.0",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-router": "^1.131.36",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.542.0",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.3.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.5.3",
    "vite": "^8.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.goodlooks.recorder",
    "productName": "Good Looks!",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "package.json",
      "!node_modules/.cache/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build-icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dir"
        }
      ]
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
